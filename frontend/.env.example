# Copy to .env.local to change these. The defaults work with `npm run dev` in the backend folder.

# Where the backend API lives.
#  - Development: leave it as /api (Vite forwards /api to the backend, see vite.config.ts)
#  - Deployed:    the full URL, e.g. https://interviewforge-api.onrender.com/api
VITE_API_URL=/api

# Development only: where the Vite dev server forwards /api requests.
# BACKEND_URL=http://localhost:8000
