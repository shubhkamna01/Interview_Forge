# Copy to .env and edit. `npm run dev` works with no .env at all (it starts a local embedded PostgreSQL).

PORT=8000

# PostgreSQL connection string. Leave empty in dev to use the embedded database.
# Supabase: Project Settings > Database > Connection string (use the "Session pooler" or direct string).
DATABASE_URL=
# Set to true for hosted databases that require SSL (Supabase, Neon, Render, ...).
DATABASE_SSL=false

# REQUIRED in production: a long random string (32+ chars). Example: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend origin(s) allowed to call the API, comma separated.
CORS_ORIGIN=http://localhost:5173

# Without this code nobody can sign up as a coordinator. Give it only to your placement team.
COORDINATOR_SIGNUP_CODE=

# Times in notification text are shown in this timezone.
APP_TIMEZONE=Asia/Kolkata

# Behind a reverse proxy (Render, Railway, Nginx)? Set to the number of proxies (usually 1)
# so rate limiting sees the real client IP.
TRUST_PROXY=0
